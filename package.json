  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.7",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
