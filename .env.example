# splitbill-service 環境變數範例：複製成 .env 後填入自己的值（.env 不要提交到版本庫）
# 服務本身不會自動讀 .env：Docker 用 --env-file .env，本機用 node --env-file=.env server.js
# 各項說明見 README 的「部署」

# ── 必填 ─────────────────────────────────────────────────────────────
SPLITBILL_API_KEY=                        # Bot 連線用的共用金鑰（x-api-key），Mousebot 的 SPLITBILL_SERVICE_KEY 設成同一把

# ── Discord 登入（網頁版需要；四項缺一，網頁就只能用分享連結）。可以和音樂庫用同一個 Discord 應用程式 ──
SESSION_SECRET=                           # 至少 32 字元的隨機字串（簽登入 cookie）；換掉會讓所有人被登出
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_BASE_URL=                          # 例如 https://bill.example.com；Discord OAuth2 Redirects 要加 <PUBLIC_BASE_URL>/auth/discord/callback

# ── 權限與限制（選填） ───────────────────────────────────────────────
OWNER_USER_ID=                            # Bot 擁有者的 Discord ID（逗號分隔），與 Mousebot、音樂庫設成一樣
# TRUST_PROXY=loopback, linklocal, uniquelocal   # 只信任私有網段的反向代理（Caddy）；登入限流靠它取得真實 IP
# SPLITBILL_TRIP_LIMIT_PER_USER=100       # 每人最多建立幾個行程

# ── 帳單照片辨識（選填） ─────────────────────────────────────────────
GEMINI_API_KEY=
# GEMINI_RECEIPT_MODEL=gemini-3.1-flash-lite

# ── 資料與備份（選填，以下都是預設值） ───────────────────────────────
# PORT=3000
# SPLITBILL_DATA_DIR=./data               # Docker 內為 /app/data
# SPLITBILL_BACKUP_KEEP=7                 # 每日備份保留幾份；0 = 關閉
# SPLITBILL_REVISIONS_KEEP=50             # 每個行程保留幾個歷史版本；0 = 關閉
# SPLITBILL_ACTIVITY_KEEP=500             # 每個行程保留幾筆操作紀錄；0 = 關閉
# SPLITBILL_SQLITE_JOURNAL=WAL            # Volume 是不支援共享記憶體的網路檔案系統時改成 DELETE

# ── 正式環境的安全檢查（NODE_ENV=production 時生效，Docker 映像預設就是） ──
# SPLITBILL_ALLOW_EMPTY_INIT=1            # 只在第一次部署時設定：允許在空的資料目錄建立新資料庫
# SPLITBILL_REQUIRE_VOLUME=0              # 關閉「資料目錄沒有掛 Volume 時 /healthz 回 503」的檢查

# ── 告警與記錄（選填） ───────────────────────────────────────────────
ALERT_WEBHOOK_URL=                        # Discord webhook：每日備份失敗、寫入資料庫失敗時通知
# ALERT_NAME=splitbill                    # 告警訊息開頭的名稱
# SPLITBILL_LOG_REQUESTS=all              # 每個請求都記一行 log（預設只記 403／409／429／5xx 與慢請求）
